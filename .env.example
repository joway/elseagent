TELEGRAM_TOKEN=xxx:xxx
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ALLOWED_CHAT_ID=your_telegram_chat_id_here
WORKSPACE_DIR=./workspace
BRAINTRUST_API_KEY=your_braintrust_api_key_here

# 后端选择 AGENT_BACKEND：
#   claude = 走 `claude -p`  （Claude Code 订阅额度）
#   codex  = 走 `codex exec` （OpenAI Codex 订阅额度）
#   留空   = 走 Anthropic API
# 注意：claude/codex 模式只能用各自 CLI 自带工具，本项目 memory/cron/skills 工具不可用，
#       且机器需装好并登录对应 CLI。
# AGENT_BACKEND=claude

# claude -p 后端可选项
# CLAUDE_CLI_PATH=claude              # claude 不在 PATH 时指定路径
# CLAUDE_CLI_MODEL=claude-sonnet-4-6  # 覆盖 CLI 默认模型

# codex exec 后端可选项
# CODEX_CLI_PATH=codex                # codex 不在 PATH 时指定路径
# CODEX_CLI_MODEL=gpt-5               # 覆盖 CLI 默认模型
# CODEX_SANDBOX_MODE=workspace-write  # read-only | workspace-write | danger-full-access
