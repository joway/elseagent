{
  "name": "elseagent",
  "version": "1.0.0",
  "description": "A personal assistant agent over Telegram, powered by Claude",
  "type": "module",
  "bin": {
    "elseagent": "bin/elseagent.js"
  },
  "files": [
    "bin",
    "dist",
    "AGENTS.md",
    ".env.example"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
