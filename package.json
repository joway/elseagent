{
  "name": "elseagent",
  "version": "1.3.0",
  "description": "A personal assistant agent over Telegram, powered by Claude",
  "type": "module",
  "bin": {
    "elseagent": "bin/elseagent.js"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "AGENTS.md",
    ".env.example"
  ],
  "scripts": {
    "dev": "AGENT_MODEL=claude-haiku-4-5 tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "agent",
    "telegram",
    "claude",
    "anthropic",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.67.68",
    "@mariozechner/pi-ai": "^0.67.68",
    "@sinclair/typebox": "^0.34.0",
    "@xenova/transformers": "^2.17.2",
    "braintrust": "^3.7.1",
    "dotenv": "^16.0.0",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^0.66.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-telegram-bot-api": "^0.64.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
